<resources>
    <!-- Dark-only window theme: black background so there is no light flash before
         Compose draws, and transparent system bars (edge-to-edge is wired up in
         MainActivity via WindowCompat). -->
    <style name="Theme.MusicSyncer" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0A0A0A</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>